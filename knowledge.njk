</div>

<div class="knowledge-toolbar">

<div class="knowledge-search">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
<input type="text" id="knowledgeSearchInput" placeholder="Search articles by title, keyword or topic…" aria-label="Search Knowledge articles">
</div>

<div class="topic-chips" id="topicChips">
<button type="button" class="topic-chip active" data-topic="all">All Topics</button>
<button type="button" class="topic-chip" data-topic="Automotive &amp; EV Power Electronics">Automotive &amp; EV Power Electronics</button>
<button type="button" class="topic-chip" data-topic="Engineering Consulting &amp; Process">Engineering Consulting &amp; Process</button>
<button type="button" class="topic-chip" data-topic="Energy Storage Systems">Energy Storage Systems</button>
<button type="button" class="topic-chip" data-topic="Semiconductor &amp; Manufacturing">Semiconductor &amp; Manufacturing</button>
<button type="button" class="topic-chip" data-topic="Industrial Networking &amp; Automation">Industrial Networking &amp; Automation</button>
<button type="button" class="topic-chip" data-topic="Career &amp; Culture">Career &amp; Culture</button>
<button type="button" class="topic-chip" data-topic="Thermal Management">Thermal Management</button>
<button type="button" class="topic-chip" data-topic="AI Infrastructure">AI Infrastructure</button>
</div>

</div>

<p class="knowledge-empty" id="knowledgeEmptyState" hidden>No articles match your search. Try a different keyword or topic.</p>

<div class="knowledge-groups" id="blogGrid">
{% for group in collections.knowledgeByTopic %}
<div class="topic-group" data-topic-group="{{ group.topic }}">

<div class="topic-group-header">
<h3>{{ group.topic }}</h3>
<span class="topic-group-count">{{ group.articles.length }} article{% if group.articles.length != 1 %}s{% endif %}</span>
</div>

<div class="blog-grid">
{% for article in group.articles %}
<a class="card"
   data-search="{{ article.data.title | lower }} {{ article.data.excerpt | lower }} {{ article.data.tags | join(' ') | lower }}"
   href="{{ article.url }}" style="text-decoration:none;color:inherit;display:block">
<img class="card-photo" loading="lazy" src="{{ article.data.image }}" alt="{{ article.data.title }}">
<span class="blog-tag">{{ article.data.tags[0] }}</span>
<h3>{{ article.data.title }}</h3>
<p>{{ article.data.excerpt }}</p>
<div class="blog-meta">{{ article.data.date | readableDate }}</div>
</a>
{% endfor %}
</div>

</div>
{% endfor %}
</div>

</div>
