<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
{% set seoDescription = description or excerpt or summary %}
{% set seoImage = image or '/assets/images/design-pcba.jpg' %}
<title>{{ title | forceescape }}</title>
<meta name="description" content="{{ seoDescription | forceescape }}">
{% if noindex %}<meta name="robots" content="noindex,follow">{% endif %}
<link rel="canonical" href="{{ page.url | canonical }}">
<meta property="og:type" content="{% if '/knowledge/' in page.url %}article{% else %}website{% endif %}">
<meta property="og:site_name" content="NexBridge Solutions">
<meta property="og:title" content="{{ title | forceescape }}">
<meta property="og:description" content="{{ seoDescription | forceescape }}">
<meta property="og:url" content="{{ page.url | canonical }}">
<meta property="og:image" content="{{ seoImage | canonical | forceescape }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title | forceescape }}">
<meta name="twitter:description" content="{{ seoDescription | forceescape }}">
<meta name="twitter:image" content="{{ seoImage | canonical | forceescape }}">
{% if '/knowledge/' in page.url %}<meta property="article:published_time" content="{{ date | isoDate }}">{% endif %}
{% set structuredData = page.url | schema(title, seoDescription, date, image, updated) %}
{% if structuredData and not noindex %}<script type="application/ld+json">{{ structuredData | jsonLd | safe }}</script>{% endif %}
<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
<link rel="stylesheet" href="/style.css?v=20260927-mobile-contact">
<link rel="stylesheet" href="/assets/css/manufacturing.css?v=20260927">
</head>
<body>
    <div class="preloader">
        <div class="loader"></div>
    </div>
    <div class="scroll-progress"></div>
<header class="header"><div class="container navbar">
<a href="/" class="brand">
    <svg class="brand-logo" viewBox="0 0 320 72" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="NexBridge Solutions">
        <path d="M10 12 h22 v16 a7 7 0 0 0 0 14 v16 h-22 z" fill="none" stroke="#1B2A4A" stroke-width="3.5" stroke-linejoin="round"/>
        <path d="M62 12 h-22 v16 a7 7 0 0 1 0 14 v16 h22 z" fill="none" stroke="#5B9BD5" stroke-width="3.5" stroke-linejoin="round"/>
        <text x="96" y="46" font-family="Arial, Helvetica, sans-serif" font-weight="500" font-size="36"><tspan fill="#1B2A4A">Nex</tspan><tspan fill="#5B9BD5">Bridge</tspan></text>
    </svg>
</a>
<nav aria-label="Primary Navigation">
<ul class="nav-menu">
<li><a href="/"{% if page.url == "/" or page.url == "/index.html" %} class="active"{% endif %}>Home</a></li>

<li><a href="/solutions.html"{% if page.url and "/solutions" in page.url %} class="active"{% endif %}>Solutions</a></li>

<li><a href="/industries.html"{% if page.url == "/industries.html" %} class="active"{% endif %}>Technical Library</a></li>

<li><a href="/knowledge.html"{% if page.url and "/knowledge" in page.url %} class="active"{% endif %}>Knowledge</a></li>

<li><a href="/about.html"{% if page.url == "/about.html" %} class="active"{% endif %}>About</a></li>

</ul>
</nav>
<a href="/account.html" class="member-nav-link" aria-label="Member account">Member</a>
<button type="button" class="search-trigger" id="siteSearchTrigger" aria-label="Search the site">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
</button>
<button class="menu-toggle">☰</button>
<a href="/contact.html" class="btn btn-primary header-contact">Contact<span class="header-contact-suffix"> Us</span></a>
</div></header>
<div class="search-overlay" id="siteSearchOverlay">
<div class="search-panel">
<div class="search-panel-header">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
<input type="text" id="siteSearchInput" placeholder="Search articles, solutions, pages…" autocomplete="off">
<button type="button" class="search-close" id="siteSearchClose" aria-label="Close search">&times;</button>
</div>
<div class="search-results" id="siteSearchResults"></div>
</div>
</div>
<main>
{{ content | safe }}
</main>
<footer class="footer"><div class="container footer-inner">
<svg class="footer-logo" viewBox="0 0 320 72" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="NexBridge Solutions">
    <path d="M10 12 h22 v16 a7 7 0 0 0 0 14 v16 h-22 z" fill="none" stroke="#FFFFFF" stroke-width="3.5" stroke-linejoin="round"/>
    <path d="M62 12 h-22 v16 a7 7 0 0 1 0 14 v16 h22 z" fill="none" stroke="#5B9BD5" stroke-width="3.5" stroke-linejoin="round"/>
    <text x="96" y="46" font-family="Arial, Helvetica, sans-serif" font-weight="500" font-size="36"><tspan fill="#FFFFFF">Nex</tspan><tspan fill="#5B9BD5">Bridge</tspan></text>
</svg>
<span>&copy; NexBridge Solutions &middot; Business ID 0111595881</span>
</div></footer>
<script src="/script.js"></script>
{% if memberPage %}
<script>window.NEXBRIDGE_MEMBER_CONFIG={url:"{{ members.supabaseUrl }}",key:"{{ members.supabasePublishableKey }}"};</script>
<script src="https://unpkg.com/@supabase/supabase-js@2"></script>
<script src="/assets/js/member-auth.js"></script>
{% endif %}
</body></html>
