---
layout: base.njk
permalink: "about.html"
eleventyComputed:
  title: "{{ about.seo_title }}"
  description: "{{ about.seo_description }}"
---
{% set micons = {
  "target": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/></svg>',
  "eye": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>'
} %}
<section class="page-header">
<div class="hero-glow"></div>
<div class="container">
<span class="hero-eyebrow">{{ about.page_header.eyebrow }}</span>
<h1>{{ about.page_header.title }}</h1>
<p>{{ about.page_header.subtitle }}</p>
</div>
</section>

<section class="overview section fade-up" style="padding:50px 0">
<div class="container">
<div class="overview-grid" style="align-items:center">
<div class="overview-desc">
<span class="small-title">{{ about.overview.small_title }}</span>
<h2>{{ about.overview.title }}</h2>
<div class="overview-rule"></div>
{% for p in about.overview.paragraphs %}
<p>{{ p }}</p>
{% endfor %}
</div>
<div class="mission-cards">
{% for card in about.overview.mission_cards %}
<div class="mission-card">
<div class="mission-icon">{{ micons[card.icon] | safe }}</div>
<div>
<h3>{{ card.title }}</h3>
<p>{{ card.description }}</p>
</div>
</div>
{% endfor %}
</div>
</div>
</div>
</section>

<section class="focus-areas section" style="padding:40px 0">
<div class="container">
<div class="section-title center">
<span>{{ about.focus_areas.eyebrow }}</span>
<h2>{{ about.focus_areas.title }}</h2>
</div>
<img src="{{ about.focus_areas.image }}" alt="{{ about.focus_areas.title }}" style="max-width:520px;margin:0 auto 36px;border-radius:16px;border:1px solid var(--border);display:block">
<div class="values-grid">
{% for card in about.focus_areas.cards %}
<div class="value-box">
<h3>{{ card.title }}</h3>
<p>{{ card.description }}</p>
</div>
{% endfor %}
</div>
</div>
</section>

<section class="how-we-work section" style="padding:40px 0">
<div class="container">
<div class="section-title center">
<span>{{ about.how_we_work.eyebrow }}</span>
<h2>{{ about.how_we_work.title }}</h2>
</div>
<img src="{{ about.how_we_work.image }}" alt="{{ about.how_we_work.title }}" style="max-width:640px;margin:0 auto 36px;border-radius:16px;border:1px solid var(--border);display:block">
<div class="bridge-flow">
{% for step in about.how_we_work.steps %}
<div class="flow-item">
<h3>{{ step.title }}</h3>
<p>{{ step.description }}</p>
</div>
{% endfor %}
</div>
</div>
</section>

<section class="why-nexbridge section fade-up" style="padding:40px 0">
<div class="container">
<div class="section-title center">
<span>{{ about.why_nexbridge.eyebrow }}</span>
<h2>{{ about.why_nexbridge.title }}</h2>
</div>
<div class="values-grid">
{% for card in about.why_nexbridge.cards %}
<div class="value-box">
<h3>{{ card.title }}</h3>
<p>{{ card.description }}</p>
</div>
{% endfor %}
</div>
</div>
</section>

<section class="closing section fade-up" style="padding:40px 0 80px">
<div class="container" style="max-width:760px;text-align:center">
<h2>{{ about.closing.title }}</h2>
{% for p in about.closing.paragraphs %}
<p style="margin-top:18px;font-size:17px;line-height:1.8;color:var(--gray)">{{ p }}</p>
{% endfor %}
</div>
</section>
