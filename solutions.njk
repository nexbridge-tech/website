---
layout: base.njk
permalink: "solutions.html"
eleventyComputed:
  title: "{{ solutions.seo_title }}"
  description: "{{ solutions.seo_description }}"
---
{% set solIcons = {
  "battery": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="15" height="10" rx="1.5"/><line x1="20" y1="10" x2="20" y2="14"/><path d="M9 12h2l-1 3 3-4h-2l1-3z" fill="currentColor" stroke="none"/></svg>',
  "thermometer": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a2 2 0 0 0-2 2v9.2a4 4 0 1 0 4 0V5a2 2 0 0 0-2-2z"/><line x1="12" y1="8" x2="12" y2="14"/></svg>',
  "network": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><line x1="3" y1="12" x2="21" y2="12"/><path d="M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg>',
  "robot": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="18" r="2.2"/><path d="M6 15.8V11l6-3 5 2v3"/><circle cx="17" cy="8" r="2.2"/></svg>',
  "server": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="18" height="6" rx="1.5"/><circle cx="7" cy="7" r=".6" fill="currentColor" stroke="none"/><circle cx="7" cy="17" r=".6" fill="currentColor" stroke="none"/></svg>',
  "chip": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="12" height="12" rx="1.5"/><line x1="9" y1="2" x2="9" y2="6"/><line x1="15" y1="2" x2="15" y2="6"/><line x1="9" y1="18" x2="9" y2="22"/><line x1="15" y1="18" x2="15" y2="22"/><line x1="2" y1="9" x2="6" y2="9"/><line x1="2" y1="15" x2="6" y2="15"/><line x1="18" y1="9" x2="22" y2="9"/><line x1="18" y1="15" x2="22" y2="15"/></svg>',
  "compass": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M15 9l-2 6-6 2 2-6z"/></svg>'
} %}
<section class="page-header">
<div class="hero-glow"></div>
<div class="container">
<span class="hero-eyebrow">{{ solutions.page_header.eyebrow }}</span>
<h1>{{ solutions.page_header.title }}</h1>
<p>{{ solutions.page_header.subtitle }}</p>
</div>
</section>

<section id="why" class="why section fade-up">
<div class="container">
<div class="section-title center">
<span>{{ solutions.why.eyebrow }}</span>
<h2>{{ solutions.why.title_line1 }}<br>{{ solutions.why.title_line2 }}</h2>
<p>{{ solutions.why.subtitle }}</p>
</div>
<div class="why-grid">
{% for card in solutions.why.cards %}
<div class="why-card">
<div class="why-number">{{ card.number }}</div>
<h3>{{ card.title }}</h3>
<p>{{ card.description }}</p>
</div>
{% endfor %}
</div>
</div>
</section>

<section class="journey-process section fade-up">
<div class="container">
<div class="section-title center">
<span>{{ solutions.journey_process.eyebrow }}</span>
<h2>{{ solutions.journey_process.title }}</h2>
</div>
<div class="journey-line">
{% for step in solutions.journey_process.steps %}
<div class="journey-step">
<h3>{{ step.number }}</h3>
<h4>{{ step.title }}</h4>
</div>
{% endfor %}
</div>
</div>
</section>

<section id="solution-area" class="solution-area section fade-up">
<div class="container">
<div class="section-title center">
<span>{{ solutions.solution_area.eyebrow }}</span>
<h2>{{ solutions.solution_area.title }}</h2>
<p>{{ solutions.solution_area.subtitle }}</p>
</div>
<div class="solution-grid">
{% for item in solutions.solution_area.items %}
<div class="solution-item">
<div class="solution-icon">{{ solIcons[item.icon] | safe }}</div>
<h3>{{ item.title }}</h3>
<p>{{ item.description }}</p>
</div>
{% endfor %}
</div>
</div>
</section>

<section id="energy-storage" class="section fade-up">
<div class="container">
<div class="section-title center">
<span>{{ solutions.energy_storage.eyebrow }}</span>
<h2>{{ solutions.energy_storage.title }}</h2>
<p>{{ solutions.energy_storage.subtitle }}</p>
</div>
<div class="blog-grid">
{% for item in solutions.energy_storage.items %}
<div class="card">
<img class="card-photo" loading="lazy" src="{{ item.image }}" alt="{{ item.title }}">
<h3>{{ item.title }}</h3>
<p>{{ item.description }}</p>
</div>
{% endfor %}
</div>
</div>
</section>

<section id="design-services" class="section">
<div class="container">
<div class="section-title center">
<span>{{ solutions.design_services.eyebrow }}</span>
<h2>{{ solutions.design_services.title }}</h2>
<p>{{ solutions.design_services.subtitle }}</p>
</div>
<div class="blog-grid">
{% for card in solutions.design_services.cards %}
<div class="card">
<img class="card-photo" loading="lazy" src="{{ card.image }}" alt="{{ card.title }}">
<h3>{{ card.title }}</h3>
<p>{{ card.description }}</p>
</div>
{% endfor %}
</div>
</div>
</section>

<section id="capabilities" class="capabilities section fade-up">
<div class="container">
<div class="section-title center">
<span>{{ solutions.capabilities.eyebrow }}</span>
<h2>{{ solutions.capabilities.title }}</h2>
</div>
<div class="capability-grid">
{% for item in solutions.capabilities.items %}
<div class="capability">
<h3>{{ item.title }}</h3>
<p>{{ item.description }}</p>
</div>
{% endfor %}
</div>
</div>
</section>

<section class="process section fade-up">
<div class="container">
<div class="section-title">
<span>{{ solutions.process.eyebrow }}</span>
<h2>{{ solutions.process.title }}</h2>
<p>{{ solutions.process.subtitle }}</p>
</div>
<div class="timeline">
{% for step in solutions.process.steps %}
<div class="step">
<div class="circle">{{ step.number }}</div>
<div>
<h3>{{ step.title }}</h3>
<p>{{ step.description }}</p>
</div>
</div>
{% endfor %}
</div>
</div>
</section>

<section class="challenge section fade-up">
<div class="container">
<div class="section-title">
<span>{{ solutions.challenge.eyebrow }}</span>
<h2>{{ solutions.challenge.title }}</h2>
</div>
<div class="challenge-grid">
{% for card in solutions.challenge.cards %}
<div class="challenge-card">
<h3>{{ card.title }}</h3>
<p>{{ card.description }}</p>
</div>
{% endfor %}
</div>
</div>
</section>

<section class="technology section fade-up">
<div class="container">
<div class="section-title center">
<span>{{ solutions.technology.eyebrow }}</span>
<h2>{{ solutions.technology.title }}</h2>
<p>{{ solutions.technology.subtitle }}</p>
</div>
<div class="tech-grid">
{% for card in solutions.technology.cards %}
<article class="tech-card">
<div class="tech-icon">{{ card.icon }}</div>
<h3>{{ card.title }}</h3>
<p>{{ card.description }}</p>
</article>
{% endfor %}
</div>
</div>
</section>

<section class="engineers section fade-up">
<div class="container">
<div class="section-title center">
<span>{{ solutions.engineers.eyebrow }}</span>
<h2>{{ solutions.engineers.title }}</h2>
<p>{{ solutions.engineers.subtitle }}</p>
</div>
<div class="engineer-grid">
{% for card in solutions.engineers.cards %}
<div class="engineer-card">
<h3>{{ card.title }}</h3>
<p>{{ card.description }}</p>
</div>
{% endfor %}
</div>
</div>
</section>

<section class="cta">
<div class="container" style="text-align:center">
<h2>{{ solutions.cta.title }}</h2>
<p>{{ solutions.cta.text }}</p>
<a href="{{ solutions.cta.button_link }}" class="btn btn-light">{{ solutions.cta.button_text }}</a>
</div>
</section>
